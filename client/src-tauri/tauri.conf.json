{
  "$schema": "https://schema.tauri.app/2.0.0",
  "productName": "LarryAgent",
  "version": "0.1.0",
  "identifier": "com.LarryAgent.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LarryAgent",
        "width": 900,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "start-agent",
          "cmd": "uvicorn",
          "args": [
            { "validator": ".*" }
          ]
        }
      ]
    }
  }
}
