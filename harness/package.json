{
  "name": "@larryagent/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LarryAgent DSH integration workspace: Cordis bundle plugins mounted into dsh profiles.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --filter @larryagent/plugin-probe run build",
    "build:probe": "pnpm --filter @larryagent/plugin-probe run build",
    "test:isolated": "vitest run tests/guard.test.ts",
    "test:isolated:sentinel": "vitest run tests/sentinel-failfast.test.ts",
    "test:isolated:sentinel-key": "vitest run tests/sentinel-key-residue.test.ts",
    "test:isolated:sentinel-unset": "vitest run tests/sentinel-unset.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "zod": "^4.5.4"
  }
}