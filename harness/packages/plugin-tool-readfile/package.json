{
  "name": "@larryagent/plugin-tool-readfile",
  "version": "0.0.1",
  "description": "LarryAgent first product plugin (DSH-3.1 S0): registers a self-made `read_file` tool on the agent loop's tool runtime. Zero hard dependencies; degrades cleanly when a service is missing.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node test/smoke.mjs",
    "test": "pnpm build && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
